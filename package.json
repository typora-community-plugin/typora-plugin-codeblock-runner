{
  "private": true,
  "name": "codeblock-runner",
  "version": "1.0.0",
  "description": "Run JavaScript / TypeScript / HTML / Node.js / Rust / Kotlin / Haskell / Crystal / V / Go / Java code blocks in Typora.",
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build:dev": "node build.js",
    "build": "rollup -c rollup.config.js",
    "pack": "pnpm run build && node pack.js",
    "smoke": "esbuild test/smoke/backend.smoke.ts --bundle --format=esm --platform=node --outfile=.temp/backend.smoke.mjs --log-level=warning && node .temp/backend.smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "solid-js": "^1.9.5",
    "sucrase": "^3.35.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.4",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@rollup/plugin-virtual": "^3.0.2",
    "@types/jquery": "3.3.1",
    "@types/node": "16.18.0",
    "@types/typora": "npm:@typora-community-plugin/typora-types@^1.0.16",
    "@typora-community-plugin/core": "^2.10.23",
    "archiver": "^5.3.2",
    "esbuild": "^0.19.2",
    "esbuild-plugin-solid": "^0.6.0",
    "esbuild-plugin-typora": "npm:@typora-community-plugin/esbuild-plugin-typora@^1.0.12",
    "esbuild-sass-plugin": "^2.12.0",
    "rollup": "^4.1.4",
    "rollup-plugin-scss": "^4.0.0",
    "rollup-plugin-typora": "npm:@typora-community-plugin/rollup-plugin-typora@^1.1.0",
    "sass": "^1.69.5",
    "tslib": "^2.6.2",
    "typescript": "^5.8.0"
  }
}
